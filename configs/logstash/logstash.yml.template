# Auto-generated from .env by complete-setup-all-os.sh
api.http.host: "0.0.0.0"
api.http.port: 9600

# Centralized Pipeline Management
xpack.management.enabled: true
xpack.management.elasticsearch.hosts: ["${ES_ENDPOINT}"]
xpack.management.elasticsearch.api_key: "${ES_API_KEY}"
xpack.management.pipeline.id: ["snmp-polling", "snmp-traps"]
xpack.management.logstash.poll_interval: 5s

# ── ECH Monitoring (creates logs-logstash.log) ──────────
# On ECH use xpack.monitoring with elasticsearch output
xpack.monitoring.enabled: true
xpack.monitoring.elasticsearch.hosts: ["${ES_ENDPOINT}"]
xpack.monitoring.elasticsearch.api_key: "${ES_API_KEY}"
xpack.monitoring.collection.interval: 10s
xpack.monitoring.collection.pipeline.details.enabled: true

# Logging
log.level: info
log.format: json

queue.type: memory
queue.max_bytes: 1gb